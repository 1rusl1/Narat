{
  "version": 1,
  "verification": {
    "owner": "developer",
    "before_review": [
      "static",
      "build",
      "unit"
    ],
    "on_failure": "repair_with_developer",
    "read_only_tasks": "checks_first"
  },
  "roles": {
    "developer": {
      "low": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "medium": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "high": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "high"
      }
    },
    "reviewer": {
      "low": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "medium": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "high": {
        "provider": "codex",
        "models": [
          "codex:gpt-6-astra",
          "agy:gemini-4-argon-high"
        ],
        "reasoning_effort": "high"
      }
    },
    "qa": {
      "low": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "medium": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "high": {
        "provider": "codex",
        "models": [
          "codex:gpt-6-astra",
          "agy:gemini-4-argon-high"
        ],
        "reasoning_effort": "high"
      }
    },
    "acceptance": {
      "low": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "medium": {
        "provider": "codex",
        "models": [
          "codex:gpt-6.1-sol",
          "agy:gemini-3.8-flash-high"
        ],
        "reasoning_effort": "medium"
      },
      "high": {
        "provider": "codex",
        "models": [
          "codex:gpt-6-astra",
          "agy:gemini-4-argon-high"
        ],
        "reasoning_effort": "high"
      }
    }
  },
  "retry": {
    "max_developer_attempts": 3,
    "max_review_cycles": 3,
    "max_qa_cycles": 3,
    "max_same_failure": 2,
    "max_acceptance_cycles": 3
  },
  "sessions": {
    "policy": "reuse_within_task",
    "max_turns": 3,
    "max_estimated_tokens": 24000,
    "max_input_tokens": 64000,
    "rotate_after_phase": true
  },
  "context": {
    "diff_chars": 16000,
    "error_chars": 3000,
    "max_discovered_files": 20
  },
  "agent_timeout": 900,
  "max_tasks_per_run": 10,
  "max_run_seconds": 14400,
  "architecture": [
    "Swift 6 / SwiftUI / SwiftData; Supabase backend; StoreKit 2.",
    "Preserve both care and diagnosis entry points, PL/EN, offline state and subscription rights.",
    "Runtime AI classifies only; published Golden Records supply plans and advice.",
    "Never store privileged credentials on clients. Read applicable constitution/spec sections before changes."
  ],
  "required_checks": {
    "low": [
      "diff-check"
    ],
    "medium": [
      "diff-check"
    ],
    "high": [
      "diff-check"
    ]
  },
  "scope_checks": {
    "ios/": [
      "ios-tests",
      "simulator-smoke"
    ],
    "supabase/": [
      "deno-tests"
    ],
    "tools/automation/": [
      "automation-tests"
    ],
    "knowledge-base/": [
      "kb-tests",
      "catalogue-schema-sync"
    ],
    "catalogue/": [
      "kb-tests",
      "catalogue-schema-sync",
      "deno-tests"
    ]
  },
  "checks": {
    "diff-check": {
      "argv": [
        "git",
        "diff",
        "--check"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "automation-tests": {
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/automation/tests",
        "-q"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 120
    },
    "kb-tests": {
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "knowledge-base/tests",
        "-q"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 120
    },
    "catalogue-schema-sync": {
      "argv": [
        "python3",
        "knowledge-base/pipeline/sync_catalogue_schema.py",
        "--check"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 60
    },
    "t148-pipeline-gate": {
      "argv": [
        "python3",
        "tools/automation/t148_catalogue_gate.py",
        "--mode",
        "pipeline",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "qa",
      "mode": "local",
      "timeout": 180
    },
    "t148-release-gate": {
      "argv": [
        "python3",
        "tools/automation/t148_catalogue_gate.py",
        "--mode",
        "release",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "qa",
      "mode": "local",
      "timeout": 180
    },
    "ios-tests": {
      "argv": [
        "python3",
        "tools/automation/ios_gate.py",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "unit",
      "mode": "local",
      "timeout": 1800
    },
    "simulator-smoke": {
      "argv": [
        "python3",
        "tools/automation/simulator_smoke.py",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "qa",
      "mode": "local",
      "timeout": 1800
    },
    "deno-tests": {
      "argv": [
        "deno",
        "task",
        "--cwd",
        "supabase/functions",
        "test"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 300
    },
    "t152-api-tests": {
      "argv": [
        "deno",
        "test",
        "--config",
        "supabase/functions/deno.json",
        "--allow-env",
        "--allow-read",
        "--allow-net=127.0.0.1,localhost",
        "supabase/functions/_shared/tests/persistence_unavailable_test.ts"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 120
    },
    "deno-check": {
      "argv": [
        "deno",
        "check",
        "--config",
        "supabase/functions/deno.json",
        "supabase/functions/plants-api/index.ts",
        "supabase/functions/analysis-worker/index.ts"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 300
    },
    "t152-ui": {
      "argv": [
        "python3",
        "tools/automation/t152_ui_gate.py",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "qa",
      "mode": "local",
      "timeout": 900
    },
    "t152-live-api": {
      "argv": [
        "python3",
        "tools/automation/t152_live_api_gate.py",
        "--run-id",
        "{check_run_id}"
      ],
      "stage": "qa",
      "mode": "live",
      "timeout": 180
    },
    "t157-question-contract": {
      "argv": [
        "python3",
        "tools/automation/t157_question_contract_gate.py"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-followup-contract": {
      "argv": [
        "python3",
        "tools/automation/t157_followup_gate.py"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-no-score-routing": {
      "argv": [
        "python3",
        "tools/automation/t157_score_gate.py"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-manual-evidence": {
      "argv": [
        "python3",
        "tools/automation/t157_evidence_gate.py"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-sql-mode-upgrade": {
      "argv": [
        "python3",
        "tools/automation/t157_sql_mode_gate.py"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 300
    },
    "t157-compact-condition": {
      "argv": [
        "python3",
        "tools/automation/t157_compact_profile_gate.py",
        "condition"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-compact-plant": {
      "argv": [
        "python3",
        "tools/automation/t157_compact_profile_gate.py",
        "plant"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t157-swift-profile-dto": {
      "argv": [
        "python3",
        "tools/automation/t157_swift_profile_gate.py"
      ],
      "stage": "static",
      "mode": "local",
      "timeout": 30
    },
    "t158-rooms-upgrade": {
      "argv": [
        "python3",
        "tools/automation/t158_rooms_gate.py"
      ],
      "stage": "unit",
      "mode": "fixture",
      "timeout": 300
    }
  },
  "publish": {
    "enabled": true,
    "remote": "origin",
    "branch": "main"
  },
  "acceptance": {
    "combined_levels": [
      "low"
    ],
    "escalate_after_failures": 2
  }
}
