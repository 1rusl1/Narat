{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalogue skeleton card and import record",
  "$ref": "#/definitions/card",
  "definitions": {
    "commonName": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_property": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_entity": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_page_title": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "string",
          "pattern": "\\S"
        },
        "review_status": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "source_property"
      ],
      "additionalProperties": true
    },
    "commonNames": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commonName"
          }
        },
        "pl": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/commonName"
          }
        }
      },
      "required": [
        "en",
        "pl"
      ],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "pl": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "en",
        "pl"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "language": {
          "enum": [
            "en",
            "pl"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "article_wikidata_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^Q[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_url": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "history_url": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "attribution": {
          "type": "string",
          "pattern": "\\S"
        },
        "license": {
          "enum": [
            "CC-BY-SA-4.0"
          ]
        },
        "license_url": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "modifications": {
          "type": "string",
          "pattern": "\\S"
        },
        "review_status": {
          "type": "string",
          "pattern": "\\S"
        },
        "translation_source_language": {
          "enum": [
            "en"
          ]
        },
        "taxon_scope": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "text",
        "language",
        "source_url",
        "source_revision",
        "revision_url",
        "history_url",
        "attribution",
        "license",
        "license_url",
        "modifications",
        "review_status"
      ],
      "additionalProperties": true
    },
    "descriptions": {
      "type": "object",
      "properties": {
        "en": {
          "allOf": [
            {
              "$ref": "#/definitions/description"
            },
            {
              "properties": {
                "language": {
                  "enum": [
                    "en"
                  ]
                }
              }
            }
          ]
        },
        "pl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/description"
                },
                {
                  "properties": {
                    "language": {
                      "enum": ["pl"]
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "required": [
        "en",
        "pl"
      ],
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "properties": {
        "file_title": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_page": {
          "type": "string",
          "pattern": "^https://[^\\s/?#]+[^\\s]*$"
        },
        "local_path": {
          "type": "string",
          "pattern": "\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$"
        },
        "storage_path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mime": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "license": {
          "type": "string",
          "pattern": "\\S"
        },
        "license_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/?#]+[^\\s]*$"
        },
        "author": {
          "type": "string",
          "pattern": "\\S"
        },
        "credit": {
          "type": "string"
        },
        "attribution": {
          "type": "string",
          "pattern": "\\S"
        },
        "modifications": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "file_title",
        "source_page",
        "local_path",
        "sha256",
        "bytes",
        "width",
        "height",
        "license",
        "license_url",
        "author",
        "attribution",
        "modifications"
      ],
      "additionalProperties": true
    },
    "watering": {
      "type": "object",
      "properties": {
        "intervals_days": {
          "type": "object",
          "properties": {
            "spring": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ]
            },
            "summer": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ]
            },
            "fall": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ]
            },
            "winter": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "spring",
            "summer",
            "fall",
            "winter"
          ],
          "additionalProperties": false
        },
        "watering_method": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "drainage_preference": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "match_level": {
          "enum": [
            "species_exact",
            "species_synonym",
            "genus_representative",
            "botanical_group_representative"
          ]
        },
        "matched_on": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "repository": {
              "type": "string",
              "pattern": "^https://[^\\s/?#]+[^\\s]*$"
            },
            "commit": {
              "type": "string",
              "pattern": "\\S"
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "plantfolio_id": {
              "type": "string",
              "pattern": "\\S"
            },
            "plantfolio_type_name": {
              "type": "string"
            },
            "plantfolio_common_examples": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "repository",
            "commit",
            "snapshot_sha256",
            "plantfolio_id"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "intervals_days",
        "watering_method",
        "drainage_preference",
        "match_level",
        "matched_on",
        "source"
      ],
      "additionalProperties": true
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "card": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "plant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scientific_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "accepted_scientific_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "scientific_name_status": {
          "type": "string",
          "pattern": "\\S"
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "rank": {
          "enum": [
            "species",
            "genus",
            "hybrid"
          ]
        },
        "genus": {
          "type": "string",
          "pattern": "\\S"
        },
        "family": {
          "type": "string",
          "pattern": "\\S"
        },
        "external_taxon_ids": {
          "$ref": "#/definitions/externalIds"
        },
        "localized_name": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "common_names": {
          "$ref": "#/definitions/commonNames"
        },
        "search_aliases": {
          "$ref": "#/definitions/aliases"
        },
        "description": {
          "$ref": "#/definitions/description"
        },
        "descriptions": {
          "$ref": "#/definitions/descriptions"
        },
        "hero_image": {
          "$ref": "#/definitions/hero"
        },
        "watering": {
          "$ref": "#/definitions/watering"
        },
        "care_profile_available": {
          "type": "boolean"
        },
        "safety": {
          "type": "object",
          "properties": {
            "cat": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "safe",
                    "toxic",
                    "unknown"
                  ]
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            "dog": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "safe",
                    "toxic",
                    "unknown"
                  ]
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "cat",
            "dog"
          ],
          "additionalProperties": false
        },
        "name_source": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "taxon_id",
        "plant_id",
        "scientific_name",
        "accepted_scientific_name",
        "scientific_name_status",
        "wikidata_id",
        "rank",
        "genus",
        "family",
        "external_taxon_ids",
        "localized_name",
        "display_name",
        "common_names",
        "search_aliases",
        "description",
        "descriptions",
        "hero_image",
        "watering",
        "care_profile_available",
        "safety",
        "name_source"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "taxon_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "plant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scientific_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "scientific_name_status": {
          "type": "string",
          "pattern": "\\S"
        },
        "wikidata_id": {
          "type": "string",
          "pattern": "^Q[1-9][0-9]*$"
        },
        "rank": {
          "enum": [
            "species",
            "genus",
            "hybrid"
          ]
        },
        "genus": {
          "type": "string",
          "pattern": "\\S"
        },
        "family": {
          "type": "string",
          "pattern": "\\S"
        },
        "external_taxon_ids": {
          "$ref": "#/definitions/externalIds"
        },
        "common_names": {
          "$ref": "#/definitions/commonNames"
        },
        "search_aliases": {
          "$ref": "#/definitions/aliases"
        },
        "descriptions": {
          "$ref": "#/definitions/descriptions"
        },
        "hero_image": {
          "$ref": "#/definitions/hero"
        },
        "watering": {
          "$ref": "#/definitions/watering"
        },
        "care_profile_available": {
          "type": "boolean"
        },
        "name_source": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "draft",
            "imported_editorial_review_pending",
            "published",
            "deprecated"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "accepted_scientific_name": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "plant_id",
        "scientific_name",
        "scientific_name_status",
        "wikidata_id",
        "external_taxon_ids",
        "common_names",
        "search_aliases",
        "descriptions",
        "hero_image",
        "watering",
        "care_profile_available",
        "source_revision"
      ],
      "additionalProperties": true
    }
  }
}
