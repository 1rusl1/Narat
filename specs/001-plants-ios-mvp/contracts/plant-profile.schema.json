{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kb_release_id",
    "record_version",
    "provenance",
    "plant_id",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kb_release_id": {
      "type": "string",
      "format": "uuid"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_documents",
        "field_evidence",
        "validation"
      ],
      "properties": {
        "source_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "url",
              "retrieved_at",
              "content_hash",
              "use_basis",
              "allowed_for"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "donor_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "independence_group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "use_basis": {
                "type": "string",
                "minLength": 1
              },
              "allowed_for": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "commercial_storage",
                    "automated_collection",
                    "llm_processing",
                    "derived_records"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "field_evidence": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^/": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "locator",
                  "scope"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "validated_at",
            "unresolved_conflicts"
          ],
          "properties": {
            "method": {
              "enum": [
                "manual_review",
                "multi_source_rules"
              ]
            },
            "synthesis_model": {
              "type": "string",
              "minLength": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "guardrail_version": {
              "type": "string",
              "minLength": 1
            },
            "validated_at": {
              "type": "string",
              "format": "date-time"
            },
            "unresolved_conflicts": {
              "type": "array",
              "maxItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "plant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_toxic_to_pets",
        "toxin_type",
        "severity",
        "pet_specific",
        "unknown_reason_code"
      ],
      "properties": {
        "is_toxic_to_pets": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "toxin_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        },
        "pet_specific": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cat",
            "dog"
          ],
          "properties": {
            "cat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_ids"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "toxic",
                    "non_toxic",
                    "unknown"
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              }
            },
            "dog": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source_ids"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "toxic",
                    "non_toxic",
                    "unknown"
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "unknown_reason_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_code",
          "purpose",
          "prerequisite_check_ids",
          "contraindication_check_ids",
          "action_pl",
          "action_en",
          "next_check_interval_days"
        ],
        "properties": {
          "action_code": {
            "type": "string",
            "enum": [
              "check_soil",
              "inspect_roots",
              "inspect_leaves",
              "observe",
              "water",
              "fertilize",
              "repot",
              "prune",
              "isolate",
              "wash_pests",
              "treat_pests",
              "adjust_light",
              "adjust_humidity",
              "check_up"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "diagnostic_check",
              "routine_care",
              "humidity_management",
              "pest_removal",
              "treatment",
              "observation"
            ]
          },
          "prerequisite_check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "contraindication_check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "action_pl": {
            "type": "string",
            "minLength": 1
          },
          "action_en": {
            "type": "string",
            "minLength": 1
          },
          "action_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "next_check_interval_days": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 90
              },
              {
                "type": "null"
              }
            ]
          },
          "active_ingredients": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "actions": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "safety"
      ]
    }
  ]
}
