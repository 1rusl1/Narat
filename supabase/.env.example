# ==============================================================================
# Narat (Plants iOS MVP) — Server-Only Environment Configuration Template
# DO NOT commit real secrets or private keys to Git (.env.local is gitignored).
# Client iOS bundle ONLY receives SUPABASE_URL and SUPABASE_ANON_KEY.
# ==============================================================================

# 1. Supabase Core (Server-only service role & internal worker secret)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-only
INTERNAL_WORKER_SECRET=replace-with-random-256bit-hex-worker-secret

# 2. Cryptographic Signing Keys (Server-only HMAC/Ed25519 keys for receipts)
# Used to sign and verify analysis_receipt (TTL fallback) and decision_receipt
ANALYSIS_RECEIPT_SIGNING_KEY=replace-with-random-256bit-hex-analysis-receipt-key
DECISION_RECEIPT_SIGNING_KEY=replace-with-random-256bit-hex-decision-receipt-key
INSTALLATION_CREDENTIAL_PEPPER=replace-with-random-256bit-hex-pepper

# 3. AI Provider (Server-only — Constitution: Anthropic Claude Haiku 5.5)
ANTHROPIC_API_KEY=replace-with-server-only-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
PROVIDER_DAILY_MAX_CALLS=500

# 4. Apple App Store Server API & StoreKit 2 Verification (Server-only)
APPLE_BUNDLE_ID=app.narat.plants
APPLE_APP_APPLE_ID=0000000000
APPLE_ISSUER_ID=replace-with-app-store-connect-issuer-uuid
APPLE_KEY_ID=replace-with-app-store-connect-key-id
APPLE_PRIVATE_KEY_BASE64=replace-with-base64-encoded-p8-key
APPLE_ENVIRONMENT=Sandbox
APPLE_PRODUCT_MONTHLY_ID=app.narat.plants.pro.monthly
APPLE_PRODUCT_YEARLY_ID=app.narat.plants.pro.yearly

# 5. Auth Providers & Account Deletion Revocation (Server-only)
SUPABASE_AUTH_APPLE_CLIENT_ID=app.narat.plants
SUPABASE_AUTH_APPLE_SECRET=replace-with-apple-oauth-secret
APPLE_REVOCATION_KEY_ENCRYPTION_SECRET=replace-with-32byte-hex-encryption-key
SUPABASE_AUTH_GOOGLE_CLIENT_ID=replace-with-google-ios-client-id
SUPABASE_AUTH_GOOGLE_SECRET=replace-with-google-client-secret
